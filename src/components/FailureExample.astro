---
export interface Props {
    category: string;
    title?: string;
    description?: string;
    dataUrl?: string;
}

const {
    category,
    title,
    description,
    dataUrl = "/static/data/git-failures.json",
} = Astro.props;

const componentId = `failure-${category}`;
---

<div class="not-prose" id={componentId}>
    {title && <h3 class="text-lg font-semibold text-gray-900 mb-1">{title}</h3>}
    {description && <p class="text-gray-600 mb-4 text-sm">{description}</p>}

    <!-- Example Selector (hidden when category has only 1 example) -->
    <div id={`${componentId}-examples`} class="flex flex-wrap gap-2 mb-4">
        <!-- Populated by JS -->
    </div>

    <!-- Example Description -->
    <div class="mb-4 p-4 bg-white rounded-lg border border-gray-200">
        <p class="text-sm text-gray-700" id={`${componentId}-description`}>
            <span class="font-semibold text-gray-500">Loading...</span>
        </p>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap items-center gap-4 text-xs text-gray-500 mb-3">
        <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 bg-orange-400 rounded-sm"></div>
            <span>Message</span>
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 bg-purple-500 rounded-sm"></div>
            <span>Git Command</span>
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 bg-gray-400 rounded-sm"></div>
            <span>Action</span>
        </div>
        <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 bg-red-500 rounded-sm"></div>
            <span>Error</span>
        </div>
    </div>

    <!-- Timeline Visualization -->
    <div class="mb-4 rounded-lg border border-gray-200 bg-white p-4">
        <div>
            <div class="mb-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-red-600 w-14"
                        >Agent A</span
                    >
                    <div
                        id={`${componentId}-timeline-a`}
                        class="relative h-3 bg-gray-100 rounded-full flex-1"
                    >
                    </div>
                </div>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-blue-600 w-14"
                        >Agent B</span
                    >
                    <div
                        id={`${componentId}-timeline-b`}
                        class="relative h-3 bg-gray-100 rounded-full flex-1"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages List -->
    <div class="rounded-lg border border-gray-200 bg-white">
        <div
            class="px-4 py-2 border-b border-gray-100 flex items-center justify-between"
        >
            <span class="text-sm font-medium text-gray-700"
                >Conversation Log</span
            >
            <span
                id={`${componentId}-result`}
                class="text-xs font-medium px-2 py-1 bg-red-100 text-red-700 rounded"
            >
                FAILED
            </span>
        </div>
        <div
            id={`${componentId}-messages`}
            class="max-h-[28rem] overflow-y-auto"
        >
            <div class="text-gray-400 text-center py-6 text-sm">Loading...</div>
        </div>
    </div>
</div>

<script define:vars={{ componentId, category, dataUrl }}>
    let failureData = null;
    let currentExample = 0;

    function getStepColor(type) {
        const colors = {
            message: "bg-orange-400",
            git: "bg-purple-500",
            action: "bg-gray-400",
            error: "bg-red-500",
        };
        return colors[type] || "bg-gray-400";
    }

    function getStepLabel(type) {
        const labels = {
            message: {
                label: "Message",
                bg: "bg-orange-100",
                text: "text-orange-700",
            },
            git: { label: "Git", bg: "bg-purple-100", text: "text-purple-700" },
            action: {
                label: "Action",
                bg: "bg-gray-100",
                text: "text-gray-600",
            },
            error: { label: "Error", bg: "bg-red-100", text: "text-red-700" },
        };
        return (
            labels[type] || {
                label: type,
                bg: "bg-gray-100",
                text: "text-gray-600",
            }
        );
    }

    function parseTime(timeStr) {
        if (!timeStr) return 0;
        const parts = timeStr.split(":");
        if (parts.length === 3) {
            return (
                parseInt(parts[0]) * 3600 +
                parseInt(parts[1]) * 60 +
                parseInt(parts[2])
            );
        }
        return 0;
    }

    function renderTimeline(steps) {
        const timelineA = document.getElementById(`${componentId}-timeline-a`);
        const timelineB = document.getElementById(`${componentId}-timeline-b`);
        if (!timelineA || !timelineB) return;

        timelineA.innerHTML = "";
        timelineB.innerHTML = "";

        const agentIds = [
            ...new Set(
                steps.map((s) =>
                    s.agent.toLowerCase().replace(/[^a-z0-9]/g, ""),
                ),
            ),
        ].sort();
        const agentA = agentIds[0];

        const times = steps.map((s) => parseTime(s.time)).filter((t) => t > 0);

        if (times.length === 0) {
            steps.forEach((step, idx) => {
                const agentKey = step.agent
                    .toLowerCase()
                    .replace(/[^a-z0-9]/g, "");
                const isA = agentKey === agentA;
                const timeline = isA ? timelineA : timelineB;
                const left = (idx / Math.max(steps.length - 1, 1)) * 98;

                const block = document.createElement("div");
                block.className = `absolute top-0 h-full ${getStepColor(step.type)} cursor-pointer hover:opacity-80 transition-opacity rounded-full`;
                block.style.left = `${left}%`;
                block.style.width = "2%";
                block.style.minWidth = "4px";
                block.onclick = () => scrollToMessage(step.id);
                timeline.appendChild(block);
            });
            return;
        }

        const minTime = Math.min(...times);
        const maxTime = Math.max(...times);
        const duration = maxTime - minTime || 1;

        steps.forEach((step) => {
            const agentKey = step.agent.toLowerCase().replace(/[^a-z0-9]/g, "");
            const isA = agentKey === agentA;
            const timeline = isA ? timelineA : timelineB;

            const time = parseTime(step.time);
            const left = time > 0 ? ((time - minTime) / duration) * 98 : 50;

            const block = document.createElement("div");
            block.className = `absolute top-0 h-full ${getStepColor(step.type)} cursor-pointer hover:opacity-80 transition-opacity rounded-full`;
            block.style.left = `${left}%`;
            block.style.width = "2%";
            block.style.minWidth = "4px";
            block.onclick = () => scrollToMessage(step.id);
            timeline.appendChild(block);
        });
    }

    function renderMessages(steps) {
        const container = document.getElementById(`${componentId}-messages`);
        if (!container) return;
        container.innerHTML = "";

        const agentIds = [
            ...new Set(
                steps.map((s) =>
                    s.agent.toLowerCase().replace(/[^a-z0-9]/g, ""),
                ),
            ),
        ].sort();

        steps.forEach((step) => {
            const agentKey = step.agent.toLowerCase().replace(/[^a-z0-9]/g, "");
            const isA = agentKey === agentIds[0];
            const msgEl = document.createElement("div");
            msgEl.id = `${componentId}-msg-${step.id}`;
            msgEl.className = `px-4 py-3 border-b border-gray-50 transition-colors ${isA ? "bg-white" : "bg-gray-50/50"}`;

            const stepLabel = getStepLabel(step.type);
            let content = step.content || "";
            content = content
                .replace(
                    /`([^`]+)`/g,
                    '<code class="bg-gray-100 px-1 rounded text-xs">$1</code>',
                )
                .replace(/\n/g, "<br>");

            const highlights = [
                "DELETED",
                "BROKEN",
                "STILL",
                "TRUNCATED",
                "MESSED UP",
                "ACCIDENTALLY",
                "MISTAKE",
                "WITHOUT YOU",
                "force",
                "OVERWRITE",
                "ONLY",
            ];
            highlights.forEach((word) => {
                const regex = new RegExp(`(${word})`, "gi");
                content = content.replace(
                    regex,
                    '<span class="font-semibold text-red-600">$1</span>',
                );
            });

            const timeDisplay = step.time
                ? `<span class="text-xs text-gray-400 ml-2">${step.time}</span>`
                : "";

            const annotationHtml = step.annotation
                ? `<div class="mt-1.5 text-xs italic text-amber-600 flex items-center gap-1">
                     <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                     <span>&larr; ${step.annotation}</span>
                   </div>`
                : "";

            msgEl.innerHTML = `
                <div class="flex items-start gap-3">
                    <div class="flex-shrink-0 w-14 text-xs font-medium ${isA ? "text-red-600" : "text-blue-600"}">
                        ${isA ? "Agent A" : "Agent B"}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs px-1.5 py-0.5 rounded ${stepLabel.bg} ${stepLabel.text}">${stepLabel.label}</span>
                            ${timeDisplay}
                        </div>
                        <div class="text-sm text-gray-600 leading-relaxed">${content}</div>
                        ${annotationHtml}
                    </div>
                </div>
            `;
            container.appendChild(msgEl);
        });
    }

    function scrollToMessage(stepId) {
        const el = document.getElementById(`${componentId}-msg-${stepId}`);
        if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "center" });
            el.classList.add("bg-yellow-50");
            setTimeout(() => el.classList.remove("bg-yellow-50"), 1500);
        }
    }

    function loadExample(idx) {
        if (!failureData) return;
        currentExample = idx;

        const failures = failureData.failures[category] || [];
        if (failures.length === 0) return;

        const failure = failures[idx];

        // Update example buttons
        const buttons = document.querySelectorAll(
            `#${componentId}-examples .example-btn`,
        );
        buttons.forEach((btn, i) => {
            btn.className =
                i === idx
                    ? "example-btn px-3 py-1.5 text-xs font-medium transition-colors bg-gray-800 text-white rounded-md"
                    : "example-btn px-3 py-1.5 text-xs font-medium transition-colors bg-gray-50 text-gray-600 rounded-md hover:bg-gray-100 border border-gray-200";
        });

        // Update description
        const descEl = document.getElementById(`${componentId}-description`);
        if (descEl) {
            descEl.innerHTML = `
                <span class="font-semibold text-gray-900">${failure.name}</span> — ${failure.summary}
                <span class="text-xs text-gray-400 block mt-1">Source: ${failure.source}</span>
            `;
        }

        // Update result badge
        const resultEl = document.getElementById(`${componentId}-result`);
        if (resultEl) {
            const isPass = failure.result.toLowerCase().includes("passed");
            resultEl.className = `text-xs font-medium px-2 py-1 rounded ${isPass ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"}`;
            resultEl.textContent = failure.result;
        }

        renderTimeline(failure.steps);
        renderMessages(failure.steps);
    }

    function renderExampleButtons() {
        const container = document.getElementById(`${componentId}-examples`);
        if (!container || !failureData) return;

        const failures = failureData.failures[category] || [];
        container.innerHTML = "";

        if (failures.length <= 1) {
            container.style.display = "none";
            return;
        }

        container.style.display = "flex";
        failures.forEach((failure, idx) => {
            const btn = document.createElement("button");
            btn.className =
                idx === currentExample
                    ? "example-btn px-3 py-1.5 text-xs font-medium transition-colors bg-gray-800 text-white rounded-md"
                    : "example-btn px-3 py-1.5 text-xs font-medium transition-colors bg-gray-50 text-gray-600 rounded-md hover:bg-gray-100 border border-gray-200";
            btn.textContent = failure.name;
            btn.onclick = () => loadExample(idx);
            container.appendChild(btn);
        });
    }

    async function init() {
        try {
            const response = await fetch(dataUrl);
            failureData = await response.json();

            renderExampleButtons();
            loadExample(0);
        } catch (error) {
            console.error(`Error loading failure data for ${category}:`, error);
            const container = document.getElementById(
                `${componentId}-messages`,
            );
            if (container) {
                container.innerHTML =
                    '<div class="text-gray-400 text-center py-6 text-sm">Error loading failure data.</div>';
            }
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>

<style>
    .bg-amber-600 {
        background-color: rgb(217 119 6);
    }
    .bg-red-600 {
        background-color: rgb(220 38 38);
    }
    .bg-orange-600 {
        background-color: rgb(234 88 12);
    }
    .bg-purple-600 {
        background-color: rgb(147 51 234);
    }
    .bg-rose-600 {
        background-color: rgb(225 29 72);
    }
    .bg-indigo-600 {
        background-color: rgb(79 70 229);
    }
</style>
