---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Trajectory Viewer · CooperBench";
const description =
    "Explore multi-agent collaboration failures in CooperBench tasks";
---

<BaseLayout title={title} description={description} activeNav="Trajectories">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
        slot="head"
    />

    <style is:inline>
        .timeline-block:hover {
            z-index: 10;
            transform: scaleY(1.2);
        }
        .step-card {
            transition: all 0.2s;
        }
        .step-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .highlight-ring {
            ring-width: 2px;
            ring-color: #fbbf24;
        }
        #run-info-panel {
            max-height: 28rem;
            transition:
                max-height 0.25s ease-out,
                opacity 0.2s ease-out,
                padding 0.25s ease-out,
                border-width 0.2s ease-out;
        }
        #run-info-panel.run-info-folded {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            padding-top: 0;
            padding-bottom: 0;
            border-bottom-width: 0;
        }
    </style>

    <main class="pt-14 h-screen flex flex-col bg-gray-50">
        <!-- Header / Control Bar -->
        <div
            class="bg-white border-b border-gray-200 px-6 py-4 flex-shrink-0 z-40 shadow-sm hidden"
        >
            <div
                class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center justify-between gap-4"
            >
                <div class="flex items-center gap-4">
                    <h1 class="text-xl font-semibold text-gray-900">
                        Trajectory Viewer
                    </h1>
                    <div class="h-6 w-px bg-gray-200 hidden lg:block"></div>

                    <!-- File Input Removed as requested -->
                </div>

                <!-- Example Buttons -->
            </div>

            <div id="load-status" class="hidden mt-2 text-sm text-center"></div>
        </div>

        <!-- Main Viewer Area -->
        <div
            id="viewer-container"
            class="flex-1 overflow-hidden relative flex flex-col max-w-7xl mx-auto w-full"
        >
            <!-- Empty State -->
            <div
                id="empty-state"
                class="absolute inset-0 flex items-center justify-center bg-gray-50 z-10"
            >
                <div class="text-center text-gray-500 max-w-md px-6">
                    <i class="fas fa-code-branch text-4xl mb-4 text-gray-300"
                    ></i>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">
                        No trajectory loaded
                    </h3>
                    <p class="text-sm">
                        Upload JSON trajectory files or select an example above
                        to visualize the collaboration process.
                    </p>

                    <div
                        class="mt-6 p-4 bg-white rounded-lg border border-gray-200 shadow-sm text-left"
                    >
                        <p class="text-xs font-mono text-gray-500 mb-2">
                            Or paste JSON directly:
                        </p>
                        <textarea
                            id="json-input"
                            class="w-full h-24 text-xs font-mono border border-gray-200 rounded p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                            placeholder='{"stepsA": [...], "stepsB": [...]} or [...]'
                        ></textarea>
                        <button
                            onclick="loadFromPaste()"
                            class="mt-2 w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium py-1.5 rounded transition-colors"
                            >Load from Text</button
                        >
                    </div>
                </div>
            </div>

            <!-- Viewer Content (Hidden initially) -->
            <div id="viewer-section" class="flex-1 flex flex-col h-full hidden">
                <!-- Run info panel (full metadata when available) -->
                <div
                    id="run-info-panel"
                    class="flex-none bg-white border-b border-gray-200 px-6 py-4 hidden"
                >
                    <div
                        class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl"
                    >
                        <div id="run-info-agent-a" class="hidden">
                            <div
                                class="text-[10px] font-semibold uppercase tracking-wide text-red-500 mb-2"
                            >
                                Agent A
                            </div>
                            <dl class="space-y-1 text-xs text-gray-600">
                                <div class="flex justify-between">
                                    <dt>Model</dt><dd
                                        id="run-a-model"
                                        class="font-medium text-gray-900 text-right"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Steps</dt><dd
                                        id="run-a-steps"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Input Tokens</dt><dd
                                        id="run-a-input-tokens"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Output Tokens</dt><dd
                                        id="run-a-output-tokens"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Cost</dt><dd
                                        id="run-a-cost"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                            </dl>
                        </div>
                        <div id="run-info-agent-b" class="hidden">
                            <div
                                class="text-[10px] font-semibold uppercase tracking-wide text-blue-500 mb-2"
                            >
                                Agent B
                            </div>
                            <dl class="space-y-1 text-xs text-gray-600">
                                <div class="flex justify-between">
                                    <dt>Model</dt><dd
                                        id="run-b-model"
                                        class="font-medium text-gray-900 text-right"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Steps</dt><dd
                                        id="run-b-steps"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Input Tokens</dt><dd
                                        id="run-b-input-tokens"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Output Tokens</dt><dd
                                        id="run-b-output-tokens"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Cost</dt><dd
                                        id="run-b-cost"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                            </dl>
                        </div>
                        <div id="run-info-global">
                            <div
                                class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-2"
                            >
                                Run
                            </div>
                            <dl class="space-y-1 text-xs text-gray-600">
                                <div class="flex justify-between">
                                    <dt>Duration</dt><dd
                                        id="run-duration"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Total Cost</dt><dd
                                        id="run-total-cost"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Started</dt><dd
                                        id="run-started"
                                        class="font-medium text-gray-900"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div
                                    id="run-task-row"
                                    class="hidden flex justify-between"
                                >
                                    <dt>Task</dt><dd
                                        id="run-task"
                                        class="font-medium text-gray-900 text-right"
                                    >
                                        —
                                    </dd>
                                </div>
                                <div class="flex items-center gap-2 text-sm">
                                    <span class="text-gray-500">Examples:</span>
                                    <button
                                        onclick="loadRandomExample('expectation')"
                                        class="text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded"
                                        >Expectation</button
                                    >
                                    <button
                                        onclick="loadRandomExample('communication')"
                                        class="text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded"
                                        >Communication</button
                                    >
                                    <button
                                        onclick="loadRandomExample('commitment')"
                                        class="text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded"
                                        >Commitment</button
                                    >
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
                <!-- Stats Bar (compact when no full metadata) -->
                <div
                    id="stats-bar"
                    class="flex-none bg-white border-b border-gray-200 px-6 py-2 flex items-center justify-between text-xs text-gray-500"
                >
                    <div class="flex flex-wrap gap-x-6 gap-y-1 items-center">
                        <div>
                            Agent A: <span
                                id="stats-agent-a"
                                class="font-medium text-gray-900">0</span
                            > steps
                        </div>
                        <div>
                            Agent B: <span
                                id="stats-agent-b"
                                class="font-medium text-gray-900">0</span
                            > steps
                        </div>
                        <div>
                            Duration: <span
                                id="stats-duration"
                                class="font-medium text-gray-900">0s</span
                            >
                        </div>
                        <div id="stats-cost-wrap" class="hidden">
                            Cost: <span
                                id="stats-cost"
                                class="font-medium text-gray-900">—</span
                            >
                        </div>
                        <div id="stats-task-wrap" class="hidden">
                            Task: <span
                                id="stats-task"
                                class="font-medium text-gray-900">—</span
                            >
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input
                                type="checkbox"
                                id="filter-comm"
                                checked
                                onchange="applyFilters()"
                                class="rounded text-blue-600 focus:ring-blue-500"
                            />
                            <span>Communication</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input
                                type="checkbox"
                                id="filter-edit"
                                checked
                                onchange="applyFilters()"
                                class="rounded text-blue-600 focus:ring-blue-500"
                            />
                            <span>Edits</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input
                                type="checkbox"
                                id="filter-view"
                                checked
                                onchange="applyFilters()"
                                class="rounded text-blue-600 focus:ring-blue-500"
                            />
                            <span>File View</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input
                                type="checkbox"
                                id="filter-bash"
                                onchange="applyFilters()"
                                class="rounded text-blue-600 focus:ring-blue-500"
                            />
                            <span>Terminal</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input
                                type="checkbox"
                                id="filter-other"
                                onchange="applyFilters()"
                                class="rounded text-blue-600 focus:ring-blue-500"
                            />
                            <span>Other</span>
                        </label>
                    </div>
                </div>

                <!-- Timeline -->
                <div
                    class="flex-none bg-white border-b border-gray-200 px-6 py-4"
                >
                    <div class="relative h-16 w-full mb-2 select-none">
                        <!-- Agent A Timeline -->
                        <div
                            class="absolute top-0 left-0 right-0 h-6 bg-red-50 rounded overflow-hidden"
                            id="timeline-a-bg"
                        >
                            <div id="timeline-a" class="relative w-full h-full">
                            </div>
                        </div>
                        <div
                            class="absolute top-1 -left-4 text-[10px] font-bold text-red-300 pointer-events-none"
                        >
                            A
                        </div>

                        <!-- Mid Spacer -->
                        <div
                            class="absolute top-6 left-0 right-0 h-4 flex items-center justify-between text-[10px] text-gray-400 px-1"
                            id="time-markers"
                        >
                            <span>00:00</span>
                            <span>End</span>
                        </div>

                        <!-- Agent B Timine -->
                        <div
                            class="absolute top-10 left-0 right-0 h-6 bg-blue-50 rounded overflow-hidden"
                            id="timeline-b-bg"
                        >
                            <div id="timeline-b" class="relative w-full h-full">
                            </div>
                        </div>
                        <div
                            class="absolute top-11 -left-4 text-[10px] font-bold text-blue-300 pointer-events-none"
                        >
                            B
                        </div>
                    </div>
                </div>

                <!-- Steps List -->
                <div
                    class="flex-1 overflow-y-auto bg-gray-50 px-6 py-6"
                    id="scroll-container"
                >
                    <div
                        class="max-w-4xl mx-auto space-y-4"
                        id="steps-container"
                    >
                        <!-- Steps rendered here -->
                    </div>
                    <div class="text-center text-xs text-gray-400 mt-8 mb-4">
                        <span id="step-count">0 steps</span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import pako from "pako";

    let stepsA = [];
    let stepsB = [];
    let allSteps = [];
    let timeRange = { start: 0, end: 0, duration: 0 };
    let causeIndex = null;
    /** Run metadata (cost, repo, task, features) when available */
    let runMetadata = {};
    /** Raw steps array (before system-prompt filter) for extracting run info from step fields */
    let rawStepsForRunInfo = [];

    // Filter out system prompt steps
    const isSystemPrompt = (step) => {
        const content = step.content || step.text || step.message || "";
        if (typeof content !== "string") return false;
        if (content.includes("You are OpenHands agent")) return true;
        if (content.includes("<ROLE>")) return true;
        if (content.includes("You are agent_")) return true;
        if (content.includes("**FEATURE DESCRIPTION**")) return true;
        if (content.includes("Added workspace context")) return true;
        return false;
    };

    // Pick first defined from multiple keys (for snake_case / camelCase)
    function pick(obj, ...keys) {
        if (obj == null) return undefined;
        for (const k of keys) {
            if (obj[k] != null && obj[k] !== "") return obj[k];
        }
        return undefined;
    }

    // Normalize one agent block from metadata (agent_a, agent_1, etc.)
    function normalizeAgentMeta(meta) {
        if (!meta || typeof meta !== "object") return null;
        const model = pick(meta, "model", "model_name");
        const steps = pick(meta, "steps", "step_count");
        const inputTokens = pick(meta, "input_tokens", "inputTokens");
        const outputTokens = pick(meta, "output_tokens", "outputTokens");
        const cost = pick(meta, "cost", "cost_usd", "total_cost");
        if (
            model == null &&
            steps == null &&
            inputTokens == null &&
            outputTokens == null &&
            cost == null
        )
            return null;
        return { model, steps, inputTokens, outputTokens, cost };
    }

    // Normalize trajectory data: may be array of steps or { steps, metadata?, run_metadata? }
    function normalizeTrajectoryData(data) {
        if (Array.isArray(data)) {
            runMetadata = {};
            return data;
        }
        if (data && Array.isArray(data.steps)) {
            const meta = data.metadata || data.run_metadata || {};
            const agentA = normalizeAgentMeta(
                meta.agent_a ?? meta.agent_1 ?? meta.agentA,
            );
            const agentB = normalizeAgentMeta(
                meta.agent_b ?? meta.agent_2 ?? meta.agentB,
            );
            runMetadata = {
                agent_a: agentA,
                agent_b: agentB,
                total_cost:
                    pick(meta, "total_cost", "totalCost", "total_cost_usd") ??
                    pick(data, "total_cost", "totalCost"),
                duration_seconds: pick(
                    meta,
                    "duration_seconds",
                    "durationSeconds",
                ),
                duration_ms: pick(meta, "duration_ms", "durationMs"),
                started:
                    pick(meta, "started", "started_at", "startTime") ??
                    pick(data, "started", "started_at"),
                repo: meta.repo ?? data.repo,
                task: meta.task ?? meta.task_id ?? data.task ?? data.taskId,
                features: meta.features ?? data.features,
                cost:
                    meta.total_cost ??
                    meta.total_cost_usd ??
                    meta.cost_usd ??
                    data.total_cost ??
                    data.cost_usd,
            };
            return data.steps;
        }
        return null;
    }

    // Split a flat array of steps (with agentId) into stepsA/stepsB
    function splitStepsByAgent(data) {
        stepsA = [];
        stepsB = [];
        const steps = normalizeTrajectoryData(data);
        if (!steps) return;
        rawStepsForRunInfo = Array.isArray(steps) ? steps : [];
        steps.forEach((step) => {
            if (isSystemPrompt(step)) return;
            if (step.agentId === "agent_1" || step.agent === "A") {
                stepsA.push({ ...step, originalIndex: stepsA.length });
            } else {
                stepsB.push({ ...step, originalIndex: stepsB.length });
            }
        });
    }

    // Clean model names e.g. "global.anthropic.claude-sonnet-4-5-20250929-v1:0" → "claude-sonnet-4-5@20250929"
    function cleanModelName(model) {
        if (model == null || model === "") return null;
        let cleaned = String(model).replace(/^global\.\w+\./, "");
        cleaned = cleaned.replace(/-(\d{8})-v\d+:\d+$/, "@$1");
        cleaned = cleaned.replace(/-v\d+:\d+$/, "");
        return cleaned;
    }

    // Extract run info from raw steps (same logic as main branch coop-trajectory.html)
    function extractRunInfoFromSteps(rawSteps) {
        if (!rawSteps?.length) return;
        const agent1Steps = rawSteps.filter(
            (s) => s.agentId === "agent_1" || s.agent === "A",
        );
        const agent2Steps = rawSteps.filter(
            (s) => s.agentId === "agent_2" || s.agent === "B",
        );

        function getAgentInfo(steps) {
            let model = null;
            let finalMetrics = null;
            for (const step of steps) {
                if (!model && step.tool_call_metadata?.model_response?.model) {
                    model = step.tool_call_metadata.model_response.model;
                }
            }
            for (let i = steps.length - 1; i >= 0; i--) {
                if (steps[i].llm_metrics) {
                    finalMetrics = steps[i].llm_metrics;
                    break;
                }
            }
            const usage = finalMetrics?.accumulated_token_usage || {};
            return {
                model: cleanModelName(model),
                steps: steps.length,
                inputTokens: usage.prompt_tokens ?? usage.input_tokens ?? 0,
                outputTokens:
                    usage.completion_tokens ?? usage.output_tokens ?? 0,
                cost: finalMetrics?.accumulated_cost,
            };
        }

        const infoA = getAgentInfo(agent1Steps);
        const infoB = getAgentInfo(agent2Steps);
        if (
            infoA.model != null ||
            infoA.cost != null ||
            infoA.inputTokens > 0 ||
            infoA.outputTokens > 0 ||
            infoA.steps > 0
        ) {
            runMetadata.agent_a = {
                model: infoA.model ?? "—",
                steps: infoA.steps,
                inputTokens: infoA.inputTokens,
                outputTokens: infoA.outputTokens,
                cost: infoA.cost,
            };
        }
        if (
            infoB.model != null ||
            infoB.cost != null ||
            infoB.inputTokens > 0 ||
            infoB.outputTokens > 0 ||
            infoB.steps > 0
        ) {
            runMetadata.agent_b = {
                model: infoB.model ?? "—",
                steps: infoB.steps,
                inputTokens: infoB.inputTokens,
                outputTokens: infoB.outputTokens,
                cost: infoB.cost,
            };
        }
        const totalCost = (infoA.cost ?? 0) + (infoB.cost ?? 0);
        if (totalCost > 0) runMetadata.total_cost = totalCost;

        const timestamps = rawSteps
            .map((s) => new Date(s.timestamp || s.timestampMs).getTime())
            .filter((t) => !isNaN(t));
        if (timestamps.length > 0) {
            runMetadata.started = Math.min(...timestamps);
            runMetadata.duration_ms =
                Math.max(...timestamps) - runMetadata.started;
        }
    }

    // Decompress .gz response, handling both pre-decompressed (dev server) and raw gzip
    async function decompressResponse(response) {
        const arrayBuffer = await response.arrayBuffer();
        const bytes = new Uint8Array(arrayBuffer);
        // Check for gzip magic number (0x1f 0x8b)
        if (bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b) {
            const inflated = pako.ungzip(bytes, { to: "string" });
            return JSON.parse(inflated);
        }
        // Already decompressed by the server
        const text = new TextDecoder().decode(bytes);
        return JSON.parse(text);
    }

    // Load cause index on page load
    async function initCauseIndex() {
        try {
            const response = await fetch("/static/data/causes/index.json");
            causeIndex = await response.json();

            // Check for URL params first
            const urlParams = new URLSearchParams(window.location.search);
            const model = urlParams.get("model");
            const repo = urlParams.get("repo");
            const task = urlParams.get("task");
            const features = urlParams.get("features");

            if (model && repo && task && features) {
                loadTrajectoryFromParams(model, repo, task, features);
            } else {
                // Auto-load a default trajectory
                loadRandomExample("expectation");
            }
        } catch (e) {
            console.error("Error loading cause index:", e);
        }
    }

    async function loadTrajectoryFromParams(model, repo, task, features) {
        const trajectoryPath = `/static/data/coop/trajectories/${model}/${repo}_${task}_${features}.json.gz`;
        showStatus(
            `Loading ${model} trajectory for ${repo}/${task}/${features}...`,
            "info",
        );

        try {
            const response = await fetch(trajectoryPath);
            if (!response.ok)
                throw new Error(`Trajectory not found: ${response.status}`);

            const data = await decompressResponse(response);
            splitStepsByAgent(data);
            // Set run context from URL params when not present in trajectory data
            if (runMetadata.repo == null) runMetadata.repo = repo;
            if (runMetadata.task == null) runMetadata.task = task;
            if (runMetadata.features == null) runMetadata.features = features;

            const modelNames = {
                gpt5: "GPT-5",
                claude: "Claude Sonnet 4.5",
                minimax: "MiniMax M2",
                qwen_coder: "Qwen3-Coder-30B",
                qwen: "Qwen3-30B",
            };
            const modelName = modelNames[model] || model;
            showStatus(
                `${modelName}: ${repo.replace(/_/g, " ")} / ${task} / ${features} (${stepsA.length + stepsB.length} steps)`,
                "success",
            );
            processAndRender();
        } catch (e) {
            console.error("Error loading trajectory:", e);
            showStatus(
                `Trajectory not available. Try loading a cause example instead.`,
                "error",
            );
            loadRandomExample("expectation");
        }
    }

    async function loadRandomExample(cause) {
        const examples = causeIndex?.[cause] || [];
        if (examples.length === 0) {
            showStatus("No examples available for this cause", "error");
            return;
        }

        const example = examples[Math.floor(Math.random() * examples.length)];
        if (!example.trajectory_url) {
            showStatus("Trajectory file not found", "error");
            return;
        }

        try {
            const response = await fetch("/" + example.trajectory_url);
            const data = await response.json();

            splitStepsByAgent(data);
            // Set run context from cause example when not in trajectory data
            if (runMetadata.repo == null) runMetadata.repo = example.project;
            if (runMetadata.task == null) runMetadata.task = example.task_id;
            if (runMetadata.features == null)
                runMetadata.features = example.features;

            const causeLabel = cause.charAt(0).toUpperCase() + cause.slice(1);
            showStatus(
                `${causeLabel}: ${example.project.replace(/_/g, " ")} (${stepsA.length + stepsB.length} steps)`,
                "success",
            );
            processAndRender();
        } catch (e) {
            console.error("Error loading trajectory:", e);
            showStatus("Error loading trajectory: " + e.message, "error");
        }
    }

    const RUN_INFO_FOLD_SCROLL_THRESHOLD = 80;

    function setupRunInfoFoldOnScroll() {
        const scrollContainer = document.getElementById("scroll-container");
        const runInfoPanel = document.getElementById("run-info-panel");
        if (!scrollContainer || !runInfoPanel) return;
        scrollContainer.addEventListener(
            "scroll",
            () => {
                if (runInfoPanel.classList.contains("hidden")) return;
                if (
                    scrollContainer.scrollTop > RUN_INFO_FOLD_SCROLL_THRESHOLD
                ) {
                    runInfoPanel.classList.add("run-info-folded");
                } else {
                    runInfoPanel.classList.remove("run-info-folded");
                }
            },
            { passive: true },
        );
    }

    window.addEventListener("load", () => {
        initCauseIndex();
        setupRunInfoFoldOnScroll();
    });

    function getToolType(step) {
        const toolName =
            step.tool_call_metadata?.function_name || step.toolName || "";
        const args = step.args || {};

        if (toolName === "finish") return "submit";
        if (
            toolName === "openhands_comm_send" ||
            toolName === "openhands_comm_get"
        )
            return "communication";
        if (toolName === "task_tracker") return "task_tracking";
        if (toolName === "think") return "think";

        if (toolName === "execute_bash") {
            const cmd = (args.command || "").toLowerCase();
            if (
                cmd.includes("grep") ||
                cmd.includes("find ") ||
                cmd.includes("locate")
            ) {
                return "find_grep";
            }
            return "bash";
        }

        if (toolName === "str_replace_editor") {
            const cmd = args.command;
            if (cmd === "view") return "view";
            if (cmd === "create") return "create";
            return "edit";
        }

        return "other";
    }

    function getToolColor(toolType) {
        const colors = {
            bash: "bg-yellow-400",
            find_grep: "bg-sky-300",
            view: "bg-blue-600",
            edit: "bg-green-500",
            create: "bg-green-700",
            communication: "bg-orange-400",
            task_tracking: "bg-purple-400",
            submit: "bg-red-500",
            think: "bg-gray-400",
            recall: "bg-indigo-400",
            condensation: "bg-pink-400",
            message: "bg-teal-400",
            other: "bg-gray-300",
        };
        return colors[toolType] || "bg-gray-300";
    }

