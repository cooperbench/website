                git: false,
            },
            {
                rank: 9,
                model: "Qwen3-Coder-30B",
                modelKey: "qwen_coder",
                fullName: "Qwen3-Coder-30B-A3B-Instruct (openhands)",
                score: 13.34,
                ci: [10.88, 16.18],
                framework: "OpenHands",
                git: false,
            },
            {
                rank: 10,
                model: "Gemini 3 Flash (Mini-SWE)",
                modelKey: "gemini_flash_miniswe",
