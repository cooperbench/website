---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Leaderboard · CooperBench";
const description =
    "Model performance on CooperBench collaborative coding tasks";
---

<BaseLayout title={title} description={description} activeNav="Leaderboard">
    <main class="pt-14">
        <!-- Announcement Banner -->
        <div
            class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-6"
        >
            <div
                class="max-w-4xl mx-auto flex items-center justify-center gap-3 text-sm"
            >
                <i class="fas fa-sparkles"></i>
                <span
                    ><strong>New Results:</strong> Leaderboard updated with Mini-SWE
                    Agent, Software Agent SDK frameworks, and Git access experiments!</span
                >
            </div>
        </div>

        <!-- Page Header -->
        <div class="bg-white">
            <div class="max-w-4xl mx-auto px-6 py-8">
                <h1 class="text-2xl font-semibold text-gray-900 mb-2">
                    Leaderboard
                </h1>
                <p class="text-gray-600">
                    Model performance on 652 collaborative coding tasks
                </p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-4xl mx-auto px-6 py-8">
            <!-- View Toggle -->
            <div class="flex items-center gap-4 mb-6">
                <button
                    id="btn-coop"
                    class="px-3 py-1.5 text-sm font-medium rounded-lg bg-gray-900 text-white"
                >
                    Cooperative
                </button>
                <button
                    id="btn-solo"
                    class="px-3 py-1.5 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200"
                >
                    Solo
                </button>
            </div>

            <!-- Leaderboard Table -->
            <div
                class="bg-white rounded-lg border border-gray-200 overflow-hidden"
            >
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-200 bg-gray-50">
                            <th
                                class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-2 md:px-4 py-3"
                                >Rank</th
                            >
                            <th
                                class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-2 md:px-4 py-3"
                                >Model</th
                            >
                            <th
                                class="hidden md:table-cell text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-4 py-3"
                                >Framework</th
                            >
                            <th
                                class="hidden md:table-cell text-center text-xs font-medium text-gray-500 uppercase tracking-wider px-4 py-3"
                                >Git</th
                            >
                            <th
                                class="hidden md:table-cell text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-4 py-3"
                            >
                                <span id="metric-label"
                                    >Cooperative Success Rate</span
                                >
                            </th>
                            <th
                                class="text-right text-xs font-medium text-gray-500 uppercase tracking-wider px-2 md:px-4 py-3"
                                >Score</th
                            >
                            <th class="hidden md:table-cell w-10"></th>
                        </tr>
                    </thead>
                    <tbody
                        id="leaderboard-body"
                        class="divide-y divide-gray-100"
                    >
                        <!-- Rows will be rendered here -->
                    </tbody>
                </table>
            </div>

            <!-- Legend (hidden on mobile since bar chart is hidden) -->
            <div
                id="legend"
                class="hidden md:flex mt-4 items-center gap-6 text-xs text-gray-500"
            >
                <div class="flex items-center gap-2">
                    <div id="legend-bar" class="w-3 h-3 bg-gray-900 rounded-sm">
                    </div>
                    <span id="legend-label">Cooperative</span>
                </div>
                <div class="flex items-center gap-2">
                    <div id="legend-ci" class="w-8 h-0.5 bg-gray-600"></div>
                    <span>95% CI</span>
                </div>
            </div>

            <!-- Methodology Note -->
            <div class="mt-8 p-4 bg-gray-50 rounded-lg border border-gray-200">
                <h3 class="text-sm font-medium text-gray-900 mb-2">
                    Methodology
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                    <strong>Cooperative:</strong> Two agents work on separate features
                    that may conflict. Success requires both features to pass tests
                    after merging.
                </p>
                <p class="text-sm text-gray-600 leading-relaxed mt-2">
                    <strong>Solo:</strong> A single agent implements both features.
                    This serves as the upper bound for what agents can achieve.
                </p>
                <p class="text-sm text-gray-500 mt-3">
                    All models evaluated on the same 652 tasks with identical
                    prompts and tool access.
                </p>
            </div>

            <!-- Detailed Results -->
            <div class="mt-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">
                    Detailed Results
                </h2>

                <div
                    class="bg-white rounded-lg border border-gray-200 overflow-hidden"
                >
                    <table class="w-full text-xs md:text-sm">
                        <thead>
                            <tr class="border-b border-gray-200 bg-gray-50">
                                <th
                                    class="text-left font-medium text-gray-700 px-2 md:px-4 py-3"
                                    >Model</th
                                >
                                <th
                                    class="text-center font-medium text-gray-700 px-2 md:px-4 py-3"
                                    >Solo</th
                                >
                                <th
                                    class="text-center font-medium text-gray-700 px-2 md:px-4 py-3"
                                    >Coop</th
                                >
                                <th
                                    class="text-center font-medium text-gray-700 px-2 md:px-4 py-3"
                                    >Gap</th
                                >
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Gemini 3 Flash (OpenHands SDK)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >48.6%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >26.2%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-22.4%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >GPT-5 (OpenHands)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >48.31%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >27.95%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-20.36%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Claude Sonnet 4.5 (OpenHands)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >47.1%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >25.9%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-21.2%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Gemini 3 Pro (Mini-SWE)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >36.8%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >20.4%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-16.4%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >MiniMax M2 (OpenHands)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >36.2%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >14.0%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-22.2%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Gemini 3 Flash (Mini-SWE)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >25.2%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >12.3%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-12.9%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Qwen3-Coder-30B (OpenHands)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >21.6%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >13.3%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-8.3%</td
                                >
                            </tr>
                            <tr>
                                <td class="px-2 md:px-4 py-3 font-medium"
                                    >Qwen3-30B (OpenHands)</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >6.3%</td
                                >
                                <td class="px-2 md:px-4 py-3 text-center"
                                    >4.6%</td
                                >
                                <td
                                    class="px-2 md:px-4 py-3 text-center text-red-600"
                                    >-1.7%</td
                                >
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Model Detail Panel -->
    <div
        id="panel-backdrop"
        class="fixed inset-0 bg-black/30 z-[60] opacity-0 pointer-events-none transition-opacity duration-200"
    >
    </div>
    <div
        id="model-panel"
        class="side-panel fixed inset-0 md:top-4 md:right-4 md:bottom-4 md:left-auto w-full md:max-w-4xl bg-white z-[70] shadow-2xl md:rounded-xl flex flex-col overflow-hidden transform translate-x-full transition-transform duration-250 ease-out"
    >
        <div class="flex items-center justify-between px-6 py-4">
            <div>
                <h2
                    id="panel-model-name"
                    class="text-lg font-semibold text-gray-900"
                >
                    Model Results
                </h2>
                <p id="panel-model-stats" class="text-sm text-gray-500">
                    0/0 tasks passed
                </p>
            </div>
            <button
                id="close-panel-btn"
                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Filters -->
        <div class="px-6 py-3 flex items-center gap-4">
            <input
                type="text"
                id="panel-search"
                placeholder="Search tasks..."
                class="flex-1 px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400"
            />
            <select
                id="panel-filter-status"
                class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none"
            >
                <option value="">All status</option>
                <option value="passed">Passed only</option>
                <option value="failed">Failed only</option>
            </select>
            <select
                id="panel-filter-repo"
                class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none"
            >
                <option value="">All repos</option>
            </select>
        </div>

        <!-- Task Table -->
        <div class="flex-1 overflow-y-auto">
            <table class="w-full text-sm">
                <thead class="sticky top-0 bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th
                            class="text-left font-medium text-gray-600 px-6 py-2"
                            >Repository</th
                        >
                        <th
                            class="text-left font-medium text-gray-600 px-4 py-2"
                            >Task</th
                        >
                        <th
                            class="text-left font-medium text-gray-600 px-4 py-2"
                            >Features</th
                        >
                        <th
                            class="text-center font-medium text-gray-600 px-4 py-2"
                            >Status</th
                        >
                        <th
                            class="text-center font-medium text-gray-600 px-4 py-2"
                            >Trajectory</th
                        >
                    </tr>
                </thead>
                <tbody id="panel-tasks-body" class="divide-y divide-gray-100">
                    <!-- Rows rendered here -->
                </tbody>
            </table>
        </div>
    </div>
</BaseLayout>

<script>
    const leaderboardData = {
        coop: [
            {
