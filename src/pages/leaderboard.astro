                git: false,
            },
        ],
        solo: [
            {
                rank: 1,
                model: "Gemini 3 Flash",
                modelKey: "gemini_flash_sdk",
                fullName: "gemini-3-flash-preview (openhands-sdk)",
                score: 48.6,
