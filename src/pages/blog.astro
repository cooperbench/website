---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Blog | CooperBench";
const description =
    "Latest research updates and insights on cooperative AI agents.";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => {
    return (
        new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );
});
---

<BaseLayout title={title} description={description} activeNav="Blog">
    <main class="pt-24 pb-20">
        <div class="max-w-4xl mx-auto px-6">
            <!-- Page Header -->
            <header class="mb-16">
                <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                    Blog
                </h1>
            </header>

            <!-- Blog Posts List -->
            <div class="space-y-12">
                {
                    sortedPosts.map((post) => (
                        <article class="border-b border-gray-200 pb-12 last:border-b-0">
                            <a href={`/blog/${post.slug}`} class="group block">
                                <p class="text-sm text-gray-500 mb-3">
                                    {post.data.pubDate}
                                </p>
                                <h2 class="text-3xl font-bold text-gray-900 mb-4 group-hover:text-primary transition-colors">
                                    {post.data.title}
                                </h2>
                                <p class="text-lg text-gray-600 mb-4 leading-relaxed">
                                    {post.data.description}
                                </p>
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="flex -space-x-2">
                                        {post.data.authors.map((author) => (
                                            <img
                                                src={author.image}
                                                alt={author.name}
                                                class="w-8 h-8 rounded-full border-2 border-white"
                                            />
                                        ))}
                                    </div>
                                    <p class="text-sm text-gray-700">
                                        {post.data.authors
                                            .map((author) => author.name)
                                            .join(", ")}
                                    </p>
                                </div>
                                <span class="text-primary font-medium group-hover:underline">
                                    Read more →
                                </span>
                            </a>
                        </article>
                    ))
                }
            </div>

            {
                sortedPosts.length === 0 && (
                    <div class="text-center py-12">
                        <p class="text-gray-500">
                            No blog posts yet. Check back soon!
                        </p>
                    </div>
                )
            }
        </div>
    </main>
</BaseLayout>
